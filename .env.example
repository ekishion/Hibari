# 复制为 .env 后填写（.env 已 gitignore，不要提交）
# 可与 config.json 叠加；同名项环境变量优先。

# BAIDU_COOKIE=BDUSS=...; STOKEN=...
# ACCESS_TOKEN=
# 会话签名密钥；留空则由 ACCESS_TOKEN 派生。改这个值可一键强制所有人重新登录。
# SESSION_SECRET=
# 登录会话有效期（秒），默认 7 天（604800）。
# AUTH_SESSION_TTL_SECONDS=604800
# FORCE_SECURE_COOKIE=true
# PORT=4172
# BIND_ADDRESS=0.0.0.0
# 仅填写实际反代服务器的 IP/CIDR；为空时完全不信任 X-Forwarded-For
# TRUSTED_PROXY_IPS=127.0.0.1,::1,10.0.0.0/8
# 启用 JSONL 下载审计；目录需提前创建并确保进程可写
# AUDIT_LOG_PATH=./data/download-audit.jsonl
# 共享目录白名单，多个路径用英文逗号分隔；为空时不限制
# ALLOWED_PATHS=/共享资料,/临时中转
# 目录短链有效期（秒），默认 7 天（604800）
# DIR_LINK_TTL_SECONDS=604800
# 状态持久化：none（默认，重启后短链失效）/ sqlite（推荐）/ json
# STATE_BACKEND=sqlite
# STATE_PATH=./data/state.db
# 目录列表翻页上限（每页 100 项），默认 15 页
# LIST_MAX_PAGES=15
# 图片预览大小上限（MB，整数），不填默认 16
# PREVIEW_MAX_MB=16
# README/文本预览大小上限（MB，整数），不填默认 0.5（即 512KB）
# README_MAX_MB=1
# 是否显示目录下的 README 说明面板，true/false，不填默认 true
# SHOW_README=true
# 是否显示 README 面板右侧的目录概览栏，true/false，不填默认 true
# SHOW_README_OVERVIEW=true
# 文件元数据缓存有效期（秒），默认 900
# FILE_CACHE_TTL_SECONDS=900
# 下载直链缓存有效期（秒），默认 300
# DLINK_CACHE_TTL_SECONDS=300
# 是否开启上传功能（true/1/yes），默认关闭；开启后登录用户可上传，消耗站长账号容量
# UPLOAD_ENABLED=true
# 单文件上传上限（MB，整数），默认 2048；0 表示不限（仍受 8GB 硬顶保护）
# UPLOAD_MAX_MB=2048
# 上传分片大小（MB，整数，0~16），默认 4（百度网页流标准分片）
# UPLOAD_CHUNK_MB=4
# TZ=Asia/Shanghai
